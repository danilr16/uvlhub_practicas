# Development image, built in two stages.
#
# Only one dependency compiles from source (python-sat); everything else in
# requirements.txt arrives as a wheel. The toolchain that builds it weighs
# hundreds of megabytes, so it lives in a stage that is thrown away. What the
# development image does keep, and production does not, is the Docker CLI: the
# dev compose mounts the daemon socket so the webhook feature and the Rosemary
# commands that drive containers work from inside.

# --------------------------------------------------------------- build stage --
FROM python:3.13-slim AS builder

ENV PIP_ROOT_USER_ACTION=ignore

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential gcc libc-dev python3-dev libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Install into a virtualenv so the runtime stage copies one self-contained
# directory instead of picking pieces out of the system site-packages.
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# ------------------------------------------------------------- runtime stage --
FROM python:3.13-slim

ENV PIP_ROOT_USER_ACTION=ignore

# mariadb-client is what the entrypoint and wait-for-db.sh call. bash and
# libstdc++, which python-sat's extension links against, already ship in the
# base image.
RUN apt-get update \
    && apt-get install -y --no-install-recommends mariadb-client curl \
    && rm -rf /var/lib/apt/lists/*

# Install Docker CLI
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates gnupg lsb-release \
    && curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/debian $(lsb_release -cs) stable" > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends docker-ce-cli \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Set the working directory in the container to /workspace
WORKDIR /workspace

# Make /workspace importable from anywhere (e.g. the rosemary CLI script in /opt/venv/bin
# imports `app` for db:seed and friends). Otherwise Python only sees /workspace on its
# sys.path while running from cwd, but installed entry-point scripts run without
# cwd in sys.path.
ENV PYTHONPATH=/workspace

# Copy the wait-for-db.sh script and set execution permissions
COPY --chmod=0755 scripts/wait-for-db.sh ./scripts/

# Copy the init-testing-db.sh script and set execution permissions
COPY --chmod=0755 scripts/init-testing-db.sh ./scripts/

# Copy files
COPY rosemary/ ./rosemary
COPY pyproject.toml ./
COPY docker/ ./docker

# Install Rosemary (lives in ./rosemary with its own pyproject). Pure Python, so
# no compiler is needed here. The development entrypoint reinstalls it against
# the bind mount on every boot, which is what makes edits to the CLI take effect.
RUN pip install --no-cache-dir -e ./rosemary

# Expose port 5000 for the Flask app
EXPOSE 5000
